# Public (exposed to client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Canonical public URL (used for OAuth redirect callback)
# Local:   http://localhost:3000
# Prod:    https://mundial-betting-xyz.a.run.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sport API config (defaults to World Cup; override for dev on EPL)
NEXT_PUBLIC_SPORT_KEY=soccer_fifa_world_cup
NEXT_PUBLIC_FOOTBALL_LEAGUE_ID=1
NEXT_PUBLIC_FOOTBALL_SEASON=2026

# Private (server only — usar Secret Manager en Cloud Run)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
THE_ODDS_API_KEY=your-odds-api-key
API_FOOTBALL_KEY=your-api-football-key

# Cron auth — generar con: openssl rand -hex 32
CRON_SECRET=generate-random-32-byte-hex

# Cloud Run
PORT=3000
HOSTNAME=0.0.0.0
TZ=America/Santiago
