# Public (exposed to client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Canonical public URL (used for OAuth redirect callback)
# Local:   http://localhost:3000
# Prod:    https://mundial-betting-xyz.a.run.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Default sport_key usado cuando un match no tiene uno explicito.
# Nuevos imports (import-league) guardan su propio sport_key por partido.
NEXT_PUBLIC_SPORT_KEY=soccer_fifa_world_cup

# Private (server only — usar Secret Manager en Cloud Run)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
THE_ODDS_API_KEY=your-odds-api-key

# Cron auth — generar con: openssl rand -hex 32
CRON_SECRET=generate-random-32-byte-hex

# Cloud Run
PORT=3000
HOSTNAME=0.0.0.0
TZ=America/Santiago
